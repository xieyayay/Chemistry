# ==============================================
# Visual Studio 相关文件
# ==============================================
.vs/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
*.user
*.userprefs

# ==============================================
# 编译产物与中间文件
# ==============================================
# 目标文件
*.slo
*.lo
*.o
*.obj
# 预编译头
*.gch
*.pch
# 动态库
*.so
*.dylib
*.dll
# Fortran 模块文件
*.mod
# 静态库
*.lai
*.la
*.a
*.lib
# 可执行文件
*.exe
*.out
*.app
*.ipa
# 引擎生成项目文件
*.xcodeproj
*.xcworkspace

# ==============================================
# UE5 核心忽略目录（白名单保护关键目录）
# ==============================================
# 二进制文件
Binaries/
Plugins/**/Binaries/

# 构建目录（仅保留 Pak 黑名单与图标）
Build/*
!Build/*/
!Build/*/PakBlacklist*.txt
!Build/**/*.ico

# 缓存与中间文件
DerivedDataCache/
Intermediate/
Plugins/**/Intermediate/
!Intermediate/Config/

# 运行时缓存/日志/截图
Saved/
Plugins/**/Saved/
!Saved/Config/

# 平台相关文件
/Platforms/

# ==============================================
# UE5 资源与自动生成文件
# ==============================================
# 源资源编译产物（保留原始资源文件）
SourceArt/**/*.png
SourceArt/**/*.tga

# 地图构建数据
*_BuiltData.uasset

# 资源备份
*.uasset.orig
*.uexp.orig
*.umap.orig

# 引擎自动生成代码
*.generated.h
*.generated.cpp
*.modules
*.manifest
*.compiled

# 着色器自动生成
Intermediate/ShaderAutogen/
*.ush

# ==============================================
# 系统与临时文件
# ==============================================
.DS_Store
Thumbs.db
*.log
*.ini.backup

# ==============================================
# 强制保留：UE5 项目核心文件（白名单）
# ==============================================
!*.uproject
!Content/
!Config/
!Source/
!Plugins/
!*.ini
!*.uasset
!*.umap